<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>Map</title>
    <link rel="stylesheet" href="css/style.css" />
  </head>

  <body>
    <header class="section-header">
      <a class="header-logo" href="/">あくまデバイス</a>
      <h1 class="header-title">ゲキシンスクアドラ攻略</h1>
      <div class="menu">
        <span>{Map}</span>
      </div>
    </header>
    <div class="section-body">
        <div id="map-container">
          <div id="map-layer"></div>
        </div>

        <div id="sidebar-right" class="sidebar-panel"> 
          <div id="sidebar-right-toggle" class="sidebar-toggle-btn">▶</div>
          <div class="sidebar-content">
            <h3>Right Chars</h3>
            <div class="character-list" id="Rcharacter-list"></div>
          </div>
        </div>

        <div id="sidebar-left" class="sidebar-panel">
          <div id="sidebar-left-toggle" class="sidebar-toggle-btn">◀</div>
          <div class="sidebar-content">
            <h3>Left Chars</h3>
            <div class="character-list" id="Lcharacter-list"></div>
          </div>
        </div>

        <div id="sidebar-bottom" class="sidebar-panel">
          <div id="sidebar-bottom-toggle" class="sidebar-toggle-btn">▼</div>
          <div class="sidebar-content">
            <div class="character-list" id="Bcharacter-list"></div>
          </div>
        </div>
    </div>
    <script src="js/map_script.js"></script>
  </body>
</html>
